# Normalize all text files to LF in the repo AND at checkout, so prettier's
# endOfLine: lf check behaves identically on every machine and CI runner.
* text=auto eol=lf

# Binary assets (extend as fixtures/fonts land)
*.png binary
*.jpg binary
*.ico binary
*.ttf binary
*.otf binary
*.pptx binary
*.xlsx binary
*.pdf binary
*.exe binary
