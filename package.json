{
  "name": "local-translate",
  "productName": "local_translate",
  "version": "0.1.0",
  "description": "Fully local file translator: every string fits its original box, zero cloud.",
  "license": "AGPL-3.0-only",
  "author": "Charlie Becquet",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run format && npm run test",
    "dist": "electron-vite build && electron-builder --win nsis",
    "translate": "tsx src/core/cli.ts",
    "make-gate-decks": "tsx scripts/make-gate-decks.mjs",
    "make-image-fixtures": "tsx scripts/make-image-fixtures.mjs",
    "spike-image-regions": "node scripts/spike-image-regions.mjs"
  },
  "dependencies": {
    "@gutenye/ocr-node": "^1.4.8",
    "@xmldom/xmldom": "^0.9.10",
    "jszip": "^3.10.1",
    "ollama": "^0.6.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "skia-canvas": "^3.0.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
